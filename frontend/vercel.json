{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://job-circular-api.onrender.com/api/$1" },
    { "source": "/admin/(.*)", "destination": "https://job-circular-api.onrender.com/admin/$1" },
    { "source": "/static/(.*)", "destination": "https://job-circular-api.onrender.com/static/$1" },
    { "source": "/media/(.*)", "destination": "https://job-circular-api.onrender.com/media/$1" },
    { "source": "/reset/(.*)", "destination": "https://job-circular-api.onrender.com/reset/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
